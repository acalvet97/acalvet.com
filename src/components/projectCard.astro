---
import type { Project } from "../types/project.ts";

const props = Astro.props as Project;
const { title, logoUrl, description, year, link, tags, imageUrl } = props;
---

<article class="project-item col-span-3 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-0">
  <div class="order-2 flex flex-col gap-6 justify-center md:order-1 md:col-span-1 md:pr-4">
    <img src={logoUrl} alt="Project Logo" class="w-20 md:w-24 h-auto">
    <p class="text-zinc-600 dark:text-zinc-400 text-base">{description}</p>
    {link && (
      <p>
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-[.75rem] px-[1.5rem] py-[.875rem] border rounded-lg border-zinc-300 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 hover:bg-zinc-800 dark:hover:bg-zinc-100 inline-flex items-center gap-2"
        >
          View Project
          <span class="material-icons !text-[1.25rem]">open_in_new</span>
        </a>
      </p>
    )}
  </div>
  <div class="order-1 md:order-2 md:col-span-2 md:px-4">
    <img src={imageUrl} alt="Project Image" class="w-full h-auto rounded-lg">
  </div>
</article>
